# Database Configuration
# Local SQLite default (for local dev and testing):
DATABASE_URL="file:./dev.db"

# For PostgreSQL (Neon / Supabase / Vercel Postgres / RDS):
# DATABASE_URL="postgresql://<username>:<password>@<host>:5432/<database>?sslmode=require"

# Authentication & Security Secrets
# In production, generate a secure random 32+ character string (e.g. `openssl rand -base64 32`)
JWT_SECRET="your_jwt_secret_key_here"
ADMIN_SECRET="your_admin_secret_key_here"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"
